{
  "name": "esquora",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "e2e": "tsx scripts/e2e.ts",
    "test": "node --import tsx --test scripts/*.test.ts src/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.9",
    "@pollar/core": "0.12.0",
    "@pollar/react": "0.12.0",
    "@stellar/stellar-sdk": "^17.4.0",
    "@tanstack/react-query": "^5.108.0",
    "hono": "^4.13.19",
    "lucide-react": "^1.74.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.5",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
