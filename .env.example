# API y origen público
PORT=8787
APP_URL=http://localhost:5173
# DATA_DIR=./data

# Pollar Testnet
VITE_POLLAR_PUBLISHABLE_KEY=
POLLAR_SECRET_KEY=
POLLAR_SERVER_URL=https://server.api.pollar.xyz

# Correo de la cuenta activa del equipo que verifica y ejecuta resoluciones en Testnet.
# Usa una cuenta de tercero designado distinta de las cuentas de servicio.
# ESQUORA_RESOLVER_EMAIL=

# Trustless Work V1 Testnet
TRUSTLESS_WORK_API_KEY=
TRUSTLESS_WORK_API_URL=https://dev.api.trustlesswork.com
HORIZON_URL=https://horizon-testnet.stellar.org
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_RPC_FALLBACK_URL=https://soroban-rpc.testnet.stellar.gateway.fm

# 90 puntos básicos equivalen al 0,9 % de la plataforma.
PLATFORM_FEE_BPS=90
# Cotización fija del banco simulado en bolivianos por USDC (referencia BCB del 17-11-2026).
# https://www.bcb.gob.bo/librerias/indicadores/otras/otras_imprimir.php?qaa=2026&qdd=17&qmm=11
ANCHOR_BOB_PER_USDC=11.70
# Reserva inicial del proveedor, en centavos de USDC de Testnet.
ANCHOR_INITIAL_CENTS=1200000
# Las claves de servicio se generan y persisten en DATA_DIR si estas variables quedan vacías.
# STELLAR_FUNDER_SECRET=
# STELLAR_PLATFORM_SECRET=
# STELLAR_ANCHOR_SECRET=

# Exclusivo de una instancia local y con al menos 32 caracteres.
# ESQUORA_TEST_AUTH_TOKEN=
